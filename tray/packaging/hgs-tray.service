[Unit]
Description=hgs tray — счётчик и меню сессий агентов
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hgs-tray
Restart=on-failure
RestartSec=5
# Код выхода 4 = "трей недоступен" (QSystemTrayIcon::isSystemTrayAvailable() == false) —
# это состояние рабочего стола (нет апплета системного трея на панели), а не сбой
# процесса, и на живой сессии само оно не меняется. С голым Restart=on-failure systemd
# ретраил бы это раз в 5 c бесконечно, только шумя в журнал. RestartPreventExitStatus
# выключает ретрай именно на этот код, но не трогает остальные — настоящий краш
# (сегфолт, код 3 "не удалось занять сокет" и т.п.) по-прежнему получает шанс подняться
# сам. Если трей на панель вернули — новую попытку даст следующий логин (юнит
# перезапускается заново при достижении graphical-session.target) либо ручной
# `systemctl --user restart hgs-tray.service`.
RestartPreventExitStatus=4

[Install]
WantedBy=graphical-session.target
