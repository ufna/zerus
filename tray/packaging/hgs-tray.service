[Unit]
Description=Zerus desktop agent development environment
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hgs-tray
Restart=on-failure
RestartSec=5
# Exit 4 means the desktop has no system tray. Retry after the next graphical
# login or an explicit restart; real crashes still use Restart=on-failure.
RestartPreventExitStatus=4
# Stop only the GUI. Native agents and persistent hosts keep running.
KillMode=process

[Install]
WantedBy=graphical-session.target
