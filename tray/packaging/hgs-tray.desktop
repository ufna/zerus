[Desktop Entry]
Type=Application
Name=Zerus
GenericName=Agent development environment
Comment=Manage persistent local and remote terminal agents
# install.sh replaces this home placeholder with the absolute user path.
# It is not a Desktop Entry field code and must be rendered before validation.
Exec=%h/.local/bin/hgs-tray --sessions
Icon=hgs-zerus-swarm-symbolic
Terminal=false
Categories=Development;System;
Keywords=hgs;tmux;claude;codex;sessions;
StartupNotify=false
StartupWMClass=hgs-tray
X-GNOME-Autostart-enabled=true
X-KDE-autostart-phase=2
