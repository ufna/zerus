# Captured terminal screens intentionally preserve whitespace and blank lines.
tests/fixtures/*.txt -whitespace

# Keep vendored libvterm byte-for-byte identical to the documented upstream.
tray/vendor/libvterm/** -whitespace

# Design prototypes and artwork are documentation, not application source.
design/** linguist-documentation

.beads export-ignore
.agents export-ignore
.github export-ignore
design export-ignore
AGENTS.md export-ignore
CLAUDE.md export-ignore

# Preserve the upstream Windows Gradle wrapper and CameraX license verbatim.
mobile/android/gradlew.bat -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
mobile/android/app/src/main/assets/licenses/camerax.txt -whitespace
