{
  "productName": "Zerus CEF Spike",
  "version": "0.1.0",
  "identifier": "dev.zerus.cefspike",
  "build": {
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../src-tauri/icons/32x32.png", "../../../src-tauri/icons/128x128.png"]
  }
}
