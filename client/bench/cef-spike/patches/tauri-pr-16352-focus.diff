diff --git a/.changes/cef-focus-in.md b/.changes/cef-focus-in.md
new file mode 100644
index 000000000000..084c5bb3fd27
--- /dev/null
+++ b/.changes/cef-focus-in.md
@@ -0,0 +1,5 @@
+---
+'tauri-runtime-cef': 'patch:bug'
+---
+
+Fixed the CEF browser on Linux not regaining keyboard focus after the window lost focus to another window and got it back.
diff --git a/crates/tauri-runtime-cef/src/runtime.rs b/crates/tauri-runtime-cef/src/runtime.rs
index 1cda866e7011..8df4a8d20a2c 100644
--- a/crates/tauri-runtime-cef/src/runtime.rs
+++ b/crates/tauri-runtime-cef/src/runtime.rs
@@ -2445,6 +2445,21 @@ impl<T: UserEvent> ApplicationHandler for WinitCefApp<T> {
         );
       }
       WinitWindowEvent::Focused(focused) => {
+        // X11 focuses the toplevel, not the browser's child window; offscreen embedders
+        // forward focus themselves.
+        #[cfg(any(
+          target_os = "linux",
+          target_os = "dragonfly",
+          target_os = "freebsd",
+          target_os = "netbsd",
+          target_os = "openbsd"
+        ))]
+        if focused
+          && let [child] = appwindow.children.as_slice()
+          && child.offscreen.is_none()
+        {
+          child.host.set_focus(1);
+        }
         self.emit_window_event(window_id, WindowEvent::Focused(focused));
       }
       WinitWindowEvent::ThemeChanged(theme) => {
