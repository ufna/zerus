+/// CEF spike: the Chromium runtime. `ZERUS_SPIKE_DEBUG_PORT` starts the DevTools
+/// protocol server on 127.0.0.1, `ZERUS_SPIKE_CACHE_DIR` names the Chromium profile.
+fn cef_runtime() -> tauri_runtime_cef::Cef {
+    use tauri_runtime_cef::{Cef, RemoteDebugging};
+    let mut cef = Cef::default().allow_chromium_command_line_args(true);
+    if let Some(dir) = std::env::var_os("ZERUS_SPIKE_CACHE_DIR").filter(|d| !d.is_empty()) {
+        cef = cef.root_cache_path(std::path::PathBuf::from(dir));
+    }
+    if let Some(port) = std::env::var("ZERUS_SPIKE_DEBUG_PORT").ok().and_then(|p| p.parse().ok()) {
+        cef = cef.remote_debugging(RemoteDebugging::Port { port, allowed_origins: Vec::new() });
+    }
+    cef
+}
